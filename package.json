{
  "name": "foreman",
  "displayName": "Foreman for Claude Code",
  "description": "%description%",
  "version": "0.1.0",
  "publisher": "shou6",
  "license": "MIT",
  "icon": "resources/icon.png",
  "galleryBanner": {
    "color": "#1F2937",
    "theme": "dark"
  },
  "homepage": "https://github.com/shou6/foreman#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/shou6/foreman.git"
  },
  "bugs": {
    "url": "https://github.com/shou6/foreman/issues"
  },
  "private": true,
  "engines": {
    "vscode": "^1.138.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "keywords": [
    "claude",
    "claude code",
    "agent",
    "tasks"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "l10n": "./l10n",
  "files": [
    "dist/extension.js",
    "dist/webview.js",
    "dist/webview.css",
    "dist/board.js",
    "dist/board.css",
    "dist/details.js",
    "dist/details.css",
    "dist/sidebar.js",
    "dist/sidebar.css",
    "dist/codicon.css",
    "dist/codicon.ttf",
    "resources/**",
    "l10n/**",
    "package.nls.json",
    "package.nls.ja.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "foreman",
          "title": "%viewContainer.title%",
          "icon": "resources/activity.svg"
        }
      ],
      "secondarySidebar": [
        {
          "id": "foreman-details",
          "title": "%viewContainer.details%",
          "icon": "resources/activity.svg"
        }
      ]
    },
    "views": {
      "foreman": [
        {
          "id": "foreman.tasks",
          "type": "webview",
          "name": "%view.tasks%",
          "icon": "resources/activity.svg"
        }
      ],
      "foreman-details": [
        {
          "id": "foreman.details",
          "type": "webview",
          "name": "%view.details%",
          "icon": "resources/activity.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "foreman.newTask",
        "title": "%command.newTask%",
        "category": "Foreman",
        "icon": "$(add)"
      },
      {
        "command": "foreman.openTask",
        "title": "%command.openTask%",
        "category": "Foreman"
      },
      {
        "command": "foreman.stopTask",
        "title": "%command.stopTask%",
        "category": "Foreman",
        "icon": "$(debug-stop)"
      },
      {
        "command": "foreman.deleteTask",
        "title": "%command.deleteTask%",
        "category": "Foreman",
        "icon": "$(trash)"
      },
      {
        "command": "foreman.attachToTask",
        "title": "%command.attachToTask%",
        "category": "Foreman",
        "icon": "$(attach)"
      },
      {
        "command": "foreman.mergeTask",
        "title": "%command.mergeTask%",
        "category": "Foreman",
        "icon": "$(git-merge)"
      },
      {
        "command": "foreman.discardTask",
        "title": "%command.discardTask%",
        "category": "Foreman",
        "icon": "$(discard)"
      },
      {
        "command": "foreman.attachSelectionToTask",
        "title": "%command.attachSelectionToTask%",
        "category": "Foreman",
        "icon": "$(selection)"
      },
      {
        "command": "foreman.exportTask",
        "title": "%command.exportTask%",
        "category": "Foreman",
        "icon": "$(export)"
      },
      {
        "command": "foreman.renameTask",
        "title": "%command.renameTask%",
        "category": "Foreman",
        "icon": "$(edit)"
      },
      {
        "command": "foreman.forkTask",
        "title": "%command.forkTask%",
        "category": "Foreman",
        "icon": "$(git-branch)"
      },
      {
        "command": "foreman.approveTask",
        "title": "%command.approveTask%",
        "category": "Foreman",
        "icon": "$(check)"
      },
      {
        "command": "foreman.unapproveTask",
        "title": "%command.unapproveTask%",
        "category": "Foreman",
        "icon": "$(discard)"
      },
      {
        "command": "foreman.startTask",
        "title": "%command.startTask%",
        "category": "Foreman",
        "icon": "$(play)"
      },
      {
        "command": "foreman.editDraft",
        "title": "%command.editDraft%",
        "category": "Foreman",
        "icon": "$(edit)"
      },
      {
        "command": "foreman.newDraft",
        "title": "%command.newDraft%",
        "category": "Foreman",
        "icon": "$(new-file)"
      },
      {
        "command": "foreman.openBoard",
        "title": "%command.openBoard%",
        "category": "Foreman",
        "icon": "$(layout)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "foreman.openTask",
          "when": "false"
        },
        {
          "command": "foreman.stopTask",
          "when": "false"
        },
        {
          "command": "foreman.deleteTask",
          "when": "false"
        },
        {
          "command": "foreman.attachToTask",
          "when": "editorIsOpen"
        },
        {
          "command": "foreman.mergeTask",
          "when": "false"
        },
        {
          "command": "foreman.discardTask",
          "when": "false"
        },
        {
          "command": "foreman.approveTask",
          "when": "false"
        },
        {
          "command": "foreman.unapproveTask",
          "when": "false"
        },
        {
          "command": "foreman.startTask",
          "when": "false"
        },
        {
          "command": "foreman.editDraft",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "foreman.newTask",
          "when": "view == foreman.tasks",
          "group": "navigation@1"
        },
        {
          "command": "foreman.openBoard",
          "when": "view == foreman.tasks",
          "group": "navigation@2"
        }
      ],
      "webview/context": [
        {
          "command": "foreman.stopTask",
          "when": "(webviewId == 'foreman.tasks' || webviewId == 'foreman.board') && webviewSection == 'task' && foremanOpen",
          "group": "1_state@1"
        },
        {
          "command": "foreman.startTask",
          "when": "(webviewId == 'foreman.tasks' || webviewId == 'foreman.board') && webviewSection == 'task' && foremanStatus == 'draft'",
          "group": "1_state@1"
        },
        {
          "command": "foreman.editDraft",
          "when": "(webviewId == 'foreman.tasks' || webviewId == 'foreman.board') && webviewSection == 'task' && foremanStatus == 'draft'",
          "group": "1_state@2"
        },
        {
          "command": "foreman.approveTask",
          "when": "(webviewId == 'foreman.tasks' || webviewId == 'foreman.board') && webviewSection == 'task' && (foremanStatus == 'review' || (foremanStatus == 'waiting' && !foremanOpen))",
          "group": "1_state@2"
        },
        {
          "command": "foreman.unapproveTask",
          "when": "(webviewId == 'foreman.tasks' || webviewId == 'foreman.board') && webviewSection == 'task' && foremanStatus == 'done' && foremanUnapprovable",
          "group": "1_state@3"
        },
        {
          "command": "foreman.mergeTask",
          "when": "(webviewId == 'foreman.tasks' || webviewId == 'foreman.board') && webviewSection == 'task' && foremanMergeable",
          "group": "2_worktree@1"
        },
        {
          "command": "foreman.discardTask",
          "when": "(webviewId == 'foreman.tasks' || webviewId == 'foreman.board') && webviewSection == 'task' && foremanWorktree && !foremanOpen && foremanStatus != 'draft'",
          "group": "2_worktree@2"
        },
        {
          "command": "foreman.forkTask",
          "when": "(webviewId == 'foreman.tasks' || webviewId == 'foreman.board') && webviewSection == 'task' && !foremanOpen && foremanStatus != 'draft'",
          "group": "3_more@1"
        },
        {
          "command": "foreman.renameTask",
          "when": "(webviewId == 'foreman.tasks' || webviewId == 'foreman.board') && webviewSection == 'task'",
          "group": "3_more@0"
        },
        {
          "command": "foreman.exportTask",
          "when": "(webviewId == 'foreman.tasks' || webviewId == 'foreman.board') && webviewSection == 'task'",
          "group": "3_more@2"
        },
        {
          "command": "foreman.deleteTask",
          "when": "(webviewId == 'foreman.tasks' || webviewId == 'foreman.board') && webviewSection == 'task'",
          "group": "4_delete@1"
        }
      ],
      "explorer/context": [
        {
          "command": "foreman.attachToTask",
          "when": "resourceScheme == file",
          "group": "foreman@1"
        }
      ],
      "editor/context": [
        {
          "command": "foreman.attachSelectionToTask",
          "when": "resourceScheme == file",
          "group": "foreman@1"
        }
      ],
      "editor/title/context": [
        {
          "command": "foreman.attachToTask",
          "when": "resourceScheme == file",
          "group": "foreman@1"
        }
      ]
    },
    "configuration": {
      "title": "Foreman for Claude Code",
      "properties": {
        "foreman.claudePath": {
          "type": "string",
          "default": "",
          "markdownDescription": "%config.claudePath%"
        },
        "foreman.defaultModel": {
          "type": "string",
          "default": "",
          "markdownDescription": "%config.defaultModel%"
        },
        "foreman.defaultEffort": {
          "type": "string",
          "enum": [
            "",
            "low",
            "medium",
            "high",
            "xhigh",
            "max"
          ],
          "enumDescriptions": [
            "%config.defaultEffort.default%",
            "%config.defaultEffort.low%",
            "%config.defaultEffort.medium%",
            "%config.defaultEffort.high%",
            "%config.defaultEffort.xhigh%",
            "%config.defaultEffort.max%"
          ],
          "default": "",
          "markdownDescription": "%config.defaultEffort%"
        },
        "foreman.notifications": {
          "type": "string",
          "enum": [
            "all",
            "waiting",
            "none"
          ],
          "enumDescriptions": [
            "%config.notifications.all%",
            "%config.notifications.waiting%",
            "%config.notifications.none%"
          ],
          "default": "all",
          "description": "%config.notifications%"
        },
        "foreman.defaultPermissionMode": {
          "type": "string",
          "enum": [
            "default",
            "acceptEdits"
          ],
          "enumDescriptions": [
            "%config.defaultPermissionMode.default%",
            "%config.defaultPermissionMode.acceptEdits%"
          ],
          "default": "default",
          "description": "%config.defaultPermissionMode%"
        },
        "foreman.taskViewWidth": {
          "type": "number",
          "default": 72,
          "minimum": 0,
          "description": "%config.taskViewWidth%"
        },
        "foreman.useWorktree": {
          "type": "boolean",
          "default": false,
          "description": "%config.useWorktree%"
        },
        "foreman.worktreeBranchPrefix": {
          "type": "string",
          "default": "foreman/",
          "description": "%config.worktreeBranchPrefix%"
        },
        "foreman.toolCalls": {
          "type": "string",
          "enum": [
            "collapsed",
            "expanded"
          ],
          "enumDescriptions": [
            "%config.toolCalls.collapsed%",
            "%config.toolCalls.expanded%"
          ],
          "default": "collapsed",
          "description": "%config.toolCalls%"
        },
        "foreman.autoTitle": {
          "type": "boolean",
          "default": true,
          "description": "%config.autoTitle%"
        },
        "foreman.titleModel": {
          "type": "string",
          "default": "haiku",
          "description": "%config.titleModel%"
        },
        "foreman.presets": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "prompt"
            ],
            "properties": {
              "name": {
                "type": "string",
                "description": "%config.presets.name%"
              },
              "prompt": {
                "type": "string",
                "description": "%config.presets.prompt%"
              }
            }
          },
          "default": [
            {
              "name": "fix",
              "prompt": "Fix the following problem. Find the root cause before changing code, explain it briefly, then make the smallest change that fixes it and verify it.\n\n{input}"
            },
            {
              "name": "test",
              "prompt": "Write tests for the following. Follow the existing test conventions of this project, cover the main path and the edge cases, and run the tests.\n\n{input}"
            },
            {
              "name": "review",
              "prompt": "Review the following changes as a careful colleague. Point out bugs, risky assumptions and missing tests first, then style. Do not change code unless asked.\n\n{input}"
            }
          ],
          "markdownDescription": "%config.presets%"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && mocha",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"*.{js,mjs,json}\" \".vscode/*.json\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"*.{js,mjs,json}\" \".vscode/*.json\"",
    "test": "vscode-test",
    "vsix": "vsce package",
    "try": "node scripts/try-extension.js",
    "test:unit": "npm run compile-tests && mocha",
    "test:integration:local": "node scripts/test-integration-local.js",
    "lint:md": "markdownlint-cli2 \"**/*.md\"",
    "verify:package": "npm run compile-tests && node scripts/verify-package.js"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.280",
    "@vscode/codicons": "^0.0.46-24",
    "diff": "^8.0.4",
    "marked": "^18.0.14",
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.138.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "markdownlint": "^0.41.1",
    "markdownlint-cli2": "^0.23.3",
    "mocha": "^12.0.2",
    "npm-run-all": "^4.1.5",
    "preact-render-to-string": "^6.7.0",
    "prettier": "^3.6.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
